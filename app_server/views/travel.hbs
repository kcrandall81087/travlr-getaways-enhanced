<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<title>Travel Packages - Travlr Getaways</title>
	<link rel="stylesheet" href="/css/style.css">
</head>

<body>
	<div id="background">
		<div id="page">
			{{> header }}

			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							<h1>Travel Packages</h1>

							<ul id="sites">
								{{#if message}}
									<li>
										<p>{{message}}</p>
									</li>
								{{else}}
									{{#each trips}}
										<li>
											<img
												src="/images/{{this.image}}"
												alt="{{this.name}}">

											<h2>{{this.name}}</h2>

											<p>
												<strong>Resort:</strong>
												{{this.resort}}
											</p>

											<p>
												<strong>Duration:</strong>
												{{this.length}}
											</p>

											<p>
												<strong>Price:</strong>
												${{this.perPerson}} per person
											</p>

											<p>{{this.description}}</p>
										</li>
									{{/each}}
								{{/if}}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>

		{{> footer }}
	</div>
</body>
</html>